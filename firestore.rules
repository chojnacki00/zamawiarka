rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- KOLEKCJE GLOBALNE ---

    // Kody parowania pozostają bez zmian na obecnym etapie.
    match /pairing_codes/{codeId} {
      allow read, write: if true;
    }

    // --- KOLEKCJE WŁAŚCICIELA (RESTAURACJI) ---
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.uid == userId;

      // 1. Zespół i pracownicy
      match /employees/{empId} {
        allow read, write: if true;
      }

      // 2. Profile uprawnień
      match /permissionProfiles/{profileId} {
        allow read, write: if true;
      }

      // 3. Stanowiska do grafiku
      match /positions/{positionId} {
        allow read, write: if true;
      }

      // 4. Niezależny słownik grup pracowniczych.
      match /employeeGroups/{groupId} {
        allow read, write: if true;
      }

      // Modele zapotrzebowania są edytowane również przez managera z sesją PIN.
      match /scheduleDemandModels/{modelId} {
        allow read, write: if true;
      }

      // 4. Dyspozycyjność pracowników
      // Dostęp pozostaje zgodny z obecną aplikacją kod + PIN.
      match /grafik_dyspozycyjnosc/{availabilityId} {
        allow read, write: if true;
      }

      // Wersja stanu dyspozycji dla konkretnego dnia.
      // Każdy prawidłowy zapis aplikacji zwiększa ją dokładnie o 1.
      match /grafik_dyspozycyjnosc_wersje/{dateKey} {
        allow read: if true;

        allow create: if
          request.resource.data.keys().hasOnly([
            'date',
            'version',
            'updatedAt'
          ]) &&
          request.resource.data.date == dateKey &&
          request.resource.data.version == 1 &&
          request.resource.data.updatedAt is timestamp;

        allow update: if
          request.resource.data.keys().hasOnly([
            'date',
            'version',
            'updatedAt'
          ]) &&
          request.resource.data.date == dateKey &&
          request.resource.data.date == resource.data.date &&
          request.resource.data.version ==
            resource.data.version + 1 &&
          request.resource.data.updatedAt is timestamp;
      }

      // 5. Okresy dyspozycji
      match /grafik_okresy_dyspozycji/{periodId} {
        allow read, write: if true;
      }

      // Trwały stan pojedynczego dnia dyspozycji.
      // Okresy mogą zostać usunięte bez utraty modelu przypisanego dniu.
      match /dyspozycje_dni/{dateKey} {
        allow read, write: if true;
      }

      // 6. Ustawienia generatora grafiku
      // Manager logujący się kodem i PIN-em korzysta z tej ścieżki
      // bez osobnej sesji Firebase Auth.
      match /grafik_ustawienia/{settingsId} {
        allow read, write: if true;
      }

      // Profile zatrudnienia tworzone samodzielnie przez managera.
      // Zawierają parametry i reguły przyszłego generatora grafiku.
      match /grafik_profile_zatrudnienia/{profileId} {
        allow read, write: if true;
      }

      // 7. Nagłówki grafików i ich stany publikacji.
      // Manager logujący się kodem i PIN-em zapisuje tu także kolejne wersje.
      match /grafiki/{scheduleId} {
        allow read, write: if true;
      }

      // Każdy dzień grafiku jest osobnym dokumentem.
      // Dokument przechowuje osobno wersję roboczą i ostatnią publikację.
      match /grafik_dni/{scheduleDayId} {
        allow read, delete: if true;
        allow create, update: if
          scheduleDayId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
          request.resource.data.id == scheduleDayId &&
          request.resource.data.date == scheduleDayId &&
          request.resource.data.scheduleId is string &&
          request.resource.data.scheduleId.size() > 0;
      }

      // Bezpieczna projekcja opublikowanego nagłówka dla przyszłego
      // widoku pracownika. Docelowe ograniczenie odczytu zostanie dodane
      // razem z właściwą tożsamością pracownika w Firebase Auth.
      match /grafiki_opublikowane/{scheduleId} {
        allow read: if true;
        allow delete: if true;
        allow create, update: if
          request.resource.data.keys().hasOnly([
            'id',
            'scheduleId',
            'name',
            'dateFrom',
            'dateTo',
            'publicationStatus',
            'publishedUntil',
            'publishedDaysCount',
            'publishedRevision',
            'publishedAt',
            'lastPublishedAt',
            'schemaVersion',
            'updatedAt'
          ]) &&
          request.resource.data.keys().hasAll([
            'id',
            'scheduleId',
            'name',
            'dateFrom',
            'dateTo',
            'publicationStatus',
            'publishedUntil',
            'publishedDaysCount',
            'publishedRevision',
            'publishedAt',
            'lastPublishedAt',
            'schemaVersion',
            'updatedAt'
          ]) &&
          request.resource.data.id == scheduleId &&
          request.resource.data.scheduleId == scheduleId &&
          request.resource.data.publicationStatus in [
            'partially_published',
            'published'
          ] &&
          request.resource.data.publishedUntil is string &&
          request.resource.data.publishedDaysCount is int &&
          request.resource.data.publishedDaysCount > 0 &&
          request.resource.data.publishedRevision is int &&
          request.resource.data.publishedRevision > 0 &&
          request.resource.data.publishedAt is timestamp &&
          request.resource.data.lastPublishedAt is timestamp &&
          request.resource.data.schemaVersion == 1 &&
          request.resource.data.updatedAt is timestamp;
      }

      // Odchudzone dni zawierają wyłącznie obsadzone, opublikowane zmiany.
      match /grafik_opublikowane_dni/{dateKey} {
        allow read: if true;
        allow delete: if true;
        allow create, update: if
          dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
          request.resource.data.keys().hasOnly([
            'id',
            'date',
            'scheduleId',
            'publishedRevision',
            'employeeIds',
            'shifts',
            'schemaVersion',
            'publishedAt',
            'updatedAt'
          ]) &&
          request.resource.data.keys().hasAll([
            'id',
            'date',
            'scheduleId',
            'publishedRevision',
            'employeeIds',
            'shifts',
            'schemaVersion',
            'publishedAt',
            'updatedAt'
          ]) &&
          request.resource.data.id == dateKey &&
          request.resource.data.date == dateKey &&
          request.resource.data.scheduleId is string &&
          request.resource.data.scheduleId.size() > 0 &&
          request.resource.data.publishedRevision is int &&
          request.resource.data.publishedRevision > 0 &&
          request.resource.data.employeeIds is list &&
          request.resource.data.shifts is list &&
          request.resource.data.schemaVersion == 1 &&
          request.resource.data.publishedAt is timestamp &&
          request.resource.data.updatedAt is timestamp;
      }

      // Rejestr przyszłych publikacji i aktualizacji grafiku.
      match /grafik_aktualizacje/{updateId} {
        allow read, write: if true;
      }

      // --- POZOSTAŁE MODUŁY ZAMAWIARKI ---

      match /cartItems/{itemId} {
        allow read, write: if true;
      }

      match /orders/{orderId} {
        allow read, write: if true;
      }

      match /towary/{towarId} {
        allow read, write: if true;
      }

      match /app/state {
        allow read, write: if true;
      }

      match /menuItems/{dishId} {
        allow read, write: if true;
      }

      // Reguła przejściowa dla pozostałych ścieżek.
      match /{allPaths=**} {
        allow read: if true;
        allow write: if request.auth != null &&
          request.auth.uid == userId;
      }
    }
  }
}
